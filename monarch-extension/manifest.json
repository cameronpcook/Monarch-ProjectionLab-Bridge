{
  "manifest_version": 3,
  "name": "Monarch \u2192 ProjectionLab Bridge",
  "version": "3.0.0",
  "description": "Sync Monarch Money account balances and budgets to ProjectionLab. Talks to Monarch directly from your browser.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://app.projectionlab.com/*",
    "https://api.monarch.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Monarch \u2192 ProjectionLab Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
